# ============================================================
#  Teduh settings
#  1. Paste your keys after the = sign. No quotes, no spaces.
#  2. Save the file, then restart the server (Ctrl+C, then npm start).
#  3. Every key is optional. A blank slot just switches that feature off.
#  NEVER share this file or upload it to GitHub. It holds your secrets.
# ============================================================

# ---------- Team ----------
# (Township Team accounts are set up further down.)

# ---------- Where the app opens ----------
# Any place in Malaysia works, for example: Putra Heights, Bandar Bukit Raja, USJ Heights
TOWNSHIP_NAME=Putra Heights
# Or give exact coordinates instead (these win over the name). Leave blank to use the name.
TOWNSHIP_LAT=
TOWNSHIP_LON=
# How far around the centre to load, in metres (300 to 1500)
TOWNSHIP_RADIUS_M=600

# ---------- Map pictures (optional) ----------
# MapTiler gives nicer, more reliable map tiles. Free key at https://cloud.maptiler.com/account/keys/
# Blank = free OpenStreetMap tiles (fine for a demo).
MAPTILER_API_KEY=

# ---------- Database option 1: Appwrite (optional) ----------
# Keeps reports when the server restarts and shares them between phones. See README, "Appwrite setup".
# APPWRITE_ENDPOINT looks like https://sgp.cloud.appwrite.io/v1 (copy it from your project's Settings page)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
# A server API key with the Databases scopes (read and write). Secret: never share it.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
# The table (older Appwrite: collection) ID. Use reports.
APPWRITE_TABLE_ID=reports
# auto works for both new (tables) and old (collections) projects
APPWRITE_API=auto
# ---------- Database option 2: Supabase (optional, only if Appwrite is blank) ----------
# From Supabase: Project Settings > API.
# SUPABASE_URL looks like https://abcdxyz.supabase.co
# SUPABASE_SERVICE_KEY is the secret "service_role" key, NOT the public "anon" key.
# Before first use, run supabase/schema.sql in the Supabase SQL Editor.
# Blank = reports are saved in a local file (data/db.json).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- AI (optional) ----------
# Optional and paid. Gemini (below) already does the chat AND the report photo check, so you can leave this blank.
# Key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Gemini is the casual "walking buddy" chat that favours shady and covered walkways.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Which AI answers the chat: auto (Gemini first, then Claude), gemini, or claude
AI_CHAT_PROVIDER=auto
# Which AI reads report photos: auto (Gemini first, then Claude), gemini, or claude
AI_TRIAGE_PROVIDER=auto

# ---------- Advanced: leave blank ----------
# Only change these if a public data service is down and you have another address for it.
OVERPASS_URL=
NOMINATIM_URL=
OPEN_METEO_GEOCODING_URL=
OPEN_METEO_FORECAST_URL=
OPEN_METEO_ELEVATION_URL=
OPEN_METEO_AIR_QUALITY_URL=

# Path Discovery: the AI looks at a resident's photo of a path (it does not draw the path).
# Free key at console.groq.com. Keep it here on the server, never in the app.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# groq or gemini. Leave empty to use Groq when a key is set, otherwise Gemini.
AI_PATH_PROVIDER=
# Satellite pictures use the same MapTiler key. Check MapTiler's terms for your use.
MAPTILER_SATELLITE_TILESET=satellite-v2

# ---- Township Team accounts and the Teduh admin ----
# Township staff create their own account on the Township Team page (staff ID + organisation email).
# The Teduh admin team signs in with the two lines below. Choose your own password and keep it secret.
ADMIN_USERNAME=teduhadmin
ADMIN_PASSWORD=
# Only these email domains may register, for example sdpproperty.com.my,pjcity.gov.my . Empty = any organisation email (personal ones like gmail are always refused).
TEAM_EMAIL_DOMAINS=
# Keeps people signed in across server restarts. Any long random text.
SESSION_SECRET=
# The public address of the hosted app. Reset links in emails start with it.
PUBLIC_URL=
# Password reset emails: free plan at brevo.com (verify one sender address) or resend.com. Fill ONE key and MAIL_FROM.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=

# ---- Weather where the person is ----
# IQAir (AirVisual): temperature, humidity, wind, air quality and the place name for the nearest station. Free key at iqair.com/air-pollution-data-api (Community plan).
# The free plan has no rain and no forecast, so rain, storms and the next 24 hours still come from Open-Meteo (no key). Leave empty to use Open-Meteo for everything.
IQAIR_API_KEY=
